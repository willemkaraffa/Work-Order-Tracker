#!/bin/sh
# pre-commit: a STAND-IN. The gate itself lives in the frame, git-hooks/pre-commit.
#
# WHY A STAND-IN (slice 9, docs/intent/2026-09-14-slice-9-project-independence.md).
# This file used to be the whole gate, copied into every project, and each copy froze
# the gates of the day it was copied: Work-Order-Tracker's ran 2 of 6 for weeks and
# nothing said so. This stand-in does not change, so a project copies it once and
# every frame update reaches it through the package.
#
# A project's OWN commit gates go in overseer.json `preCommitGates`, never in here.
#
# NOT A WAY AROUND THE GATE. If the frame cannot be found, `exec` fails, this hook
# exits non-zero, and git refuses the commit. --no-verify is blocked separately
# (~/.claude/hooks/pretool-guards.js, GATE_BYPASS).
#
# ACTIVATION (local config, not tracked, so a fresh clone must run it):
#   git config core.hooksPath .githooks

if [ -f node_modules/project-overseer/git-hooks/pre-commit ]; then
  exec sh node_modules/project-overseer/git-hooks/pre-commit "$@"
fi
# The frame's own checkout gates itself with the same body it ships.
exec sh git-hooks/pre-commit "$@"
