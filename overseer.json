{
  "verifyCommand": "npm run verify",
  "rubricFile": ".claude/rubric.md",
  "guards": [
    { "file": "scraper-data-gate.js", "label": "scraper data gate" },
    { "file": "user-authority-gate.js", "label": "user authority gate" },
    { "file": "coder-role-gate.js", "label": "coder role gate" },
    { "file": "role-lock.js", "label": "role lock" },
    { "file": "role-lock-check.js", "label": "role lock commit check" },
    { "file": "commit-authority-gate.js", "label": "commit authority gate" },
    { "file": "spawn-limiter.js", "label": "spawn limiter" }
  ],
  "roles": {
    "overseer": {
      "may": ["dispatch subagents", "ask the human", "run architect/reviewer/verify", "read", "write docs and plans"],
      "mayNotWrite": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx", "**/*.py", "src/**", "extension/**", "scripts/**", "test/**", ".claude/hooks/**", "main.js", "preload.js"]
    },
    "locked": [".claude/settings.json", "overseer.json", ".githooks/**", ".claude/hooks/coder-role-gate.js", ".claude/hooks/role-lock.js", ".claude/hooks/role-lock-check.js", ".claude/hooks/commit-authority-gate.js", ".claude/hooks/spawn-limiter.js", ".plan.json", ".review-findings.json"]
  }
}
